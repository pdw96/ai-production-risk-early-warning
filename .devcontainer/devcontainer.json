{
  "name": "AI Production Risk MVP",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "forwardPorts": [3000, 8000],
  "portsAttributes": {
    "3000": {
      "label": "AI 생산 리스크 대시보드",
      "onAutoForward": "openBrowser"
    },
    "8000": {
      "label": "FastAPI",
      "onAutoForward": "silent"
    }
  },
  // buildkit 빌드 캐시 상한. 여기서 바꿔야 Codespace를 다시 만들어도 유지된다.
  // 셸에서 DOCKER_BUILD_CACHE_MAX 만 주고 docker-gc.sh 를 돌리면 그 값은
  // 이번 실행에만 적용되고, 다음 기동 때 여기 값으로 되돌아간다.
  "containerEnv": {
    "DOCKER_BUILD_CACHE_MAX": "2GB",
    // npm/pip 다운로드 캐시를 32GB 루프 디바이스 밖으로 뺀다. /tmp 는 별도
    // 디스크(/dev/sda1, 118G)다. 재생성 가능한 캐시만 보낸다 — node_modules 나
    // .venv 는 /tmp 가 비워지면 앱이 깨지므로 저장소에 그대로 둔다.
    "NPM_CONFIG_CACHE": "/tmp/cache/npm",
    "PIP_CACHE_DIR": "/tmp/cache/pip"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  // 빌드 캐시 상한(2GB)을 매 기동 시 다시 건다. /etc 는 컨테이너 쓰기
  // 레이어라 Codespace를 다시 만들면 daemon.json 이 사라지기 때문이다.
  "postStartCommand": "bash .devcontainer/docker-gc.sh"
}
