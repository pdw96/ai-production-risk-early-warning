{
  "name": "AI Production Risk MVP",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "forwardPorts": [3000, 8000],
  "portsAttributes": {
    "3000": {
      "label": "AI 생산 리스크 대시보드",
      "onAutoForward": "openBrowser"
    },
    "8000": {
      "label": "FastAPI",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  // 빌드 캐시 상한(2GB)을 매 기동 시 다시 건다. /etc 는 컨테이너 쓰기
  // 레이어라 Codespace를 다시 만들면 daemon.json 이 사라지기 때문이다.
  "postStartCommand": "bash .devcontainer/docker-gc.sh"
}
