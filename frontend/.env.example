# 브라우저가 FastAPI를 직접 호출해야 할 때만 공개 주소를 지정합니다.
# 비워 두면 Next.js가 API_INTERNAL_BASE_URL로 요청을 프록시합니다.
NEXT_PUBLIC_API_BASE_URL=

# 주의: 이 값은 런타임 환경변수가 아니라 "빌드 시점" 값입니다.
# next.config.ts의 rewrites()는 빌드할 때 .next/routes-manifest.json으로 구워지므로,
# 빌드가 끝난 뒤에 이 값을 바꿔도 프록시 대상은 바뀌지 않습니다.
# 값을 바꾸려면 다시 빌드해야 하며, Docker에서는 API_INTERNAL_BASE_URL 빌드 인자로 전달합니다.
API_INTERNAL_BASE_URL=http://127.0.0.1:8000
